# ============ MySQL ============
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_DATABASE=qitekcomputer
MYSQL_PORT=3307

# ============ Backend ============
SECRET_KEY=change-this-to-a-random-secret-key
BACKEND_PORT=8000

# ============ SMTP (send quotation emails) ============
# For Gmail, SMTP_PASSWORD must be a 16-char App Password (not your login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@example.com
SMTP_USE_TLS=true

# ============ Frontend ============
# Leave empty to use same-origin (works with nginx reverse proxy)
# Only set if running frontend without nginx
NEXT_PUBLIC_API_URL=

# Port for the app (nginx reverse proxy). Use 8080 if port 80 is taken (apache/nginx on host).
APP_PORT=80
